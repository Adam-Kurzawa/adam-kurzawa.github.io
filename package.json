{
  "name": "personal-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "buildindex": "node index_builder.js",
    "buildfeeds": "node feeds_builder.js",
    "dev": "npm run buildindex && npm run buildfeeds && vite",
    "errorpage": "cd ./dist && del 404.html && del temp && copyfiles index.html ./temp && cd ./temp && renamer index.html --replace 404.html && copyfiles 404.html .. && cd .. && del temp && cd ..",
    "addcname": "copyfiles CNAME ./dist",
    "build": "npm run buildindex && npm run buildfeeds && vite build && npm run errorpage && npm run addcname",
    "preview": "npm run build && vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.1.0",
    "@vueuse/integrations": "^14.1.0",
    "altcha": "^2.3.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.7.0",
    "gray-matter-es": "^0.2.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "pinia": "^3.0.4",
    "prettier": "^3.7.4",
    "prettier-plugin-java": "^2.7.7",
    "tailwindcss": "^4.1.18",
    "universal-cookie": "^7.2.2",
    "vue": "^3.5.25",
    "vue-gtag": "^3.6.3",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4",
    "vuefire": "^3.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "docx4js": "^3.3.0",
    "feed": "^5.1.0",
    "gh-pages": "^6.3.0",
    "renamer": "^5.0.2",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5"
  }
}
